{
  "cyd-buddy": {
    "PreInvocation": [
      { "type": "command", "command": "python <repo>/tools/buddy_hook.py agy PreInvocation", "timeout": 8 }
    ],
    "PreToolUse": [
      { "matcher": "run_command|manage_task",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PreToolUse Bash", "timeout": 8 }] },
      { "matcher": "write_to_file|create_file|replace_file_content|multi_replace_file_content|sed_file",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PreToolUse Edit", "timeout": 8 }] },
      { "matcher": "view_file|view_code_item|list_dir|find_by_name|grep_search|codebase_search",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PreToolUse Read", "timeout": 8 }] },
      { "matcher": "search_web|read_url_content|browser_.*",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PreToolUse WebFetch", "timeout": 8 }] },
      { "matcher": "invoke_subagent|send_message",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PreToolUse Task", "timeout": 8 }] },
      { "matcher": "ask_question",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PreToolUse Ask", "timeout": 8 }] },
      { "matcher": "generate_image",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PreToolUse Image", "timeout": 8 }] }
    ],
    "PostToolUse": [
      { "matcher": "run_command|manage_task",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PostToolUse Bash", "timeout": 8 }] },
      { "matcher": "write_to_file|create_file|replace_file_content|multi_replace_file_content|sed_file",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PostToolUse Edit", "timeout": 8 }] },
      { "matcher": "view_file|view_code_item|list_dir|find_by_name|grep_search|codebase_search",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PostToolUse Read", "timeout": 8 }] },
      { "matcher": "search_web|read_url_content|browser_.*",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PostToolUse WebFetch", "timeout": 8 }] },
      { "matcher": "invoke_subagent|send_message",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PostToolUse Task", "timeout": 8 }] },
      { "matcher": "ask_question",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PostToolUse Ask", "timeout": 8 }] },
      { "matcher": "generate_image",
        "hooks": [{ "command": "python <repo>/tools/buddy_hook.py agy PostToolUse Image", "timeout": 8 }] }
    ],
    "Stop": [
      { "type": "command", "command": "python <repo>/tools/buddy_hook.py agy Stop", "timeout": 8 }
    ]
  }
}
